# ==========================================
# RTSP Multi-Camera Streaming Configuration
# ==========================================

# 1. Default Camera RTSP Stream URL (Pre-seeded as Camera 01)
# Format: rtsp://<username>:<password>@<ip_address>:<port>/<stream_path>
# Example: rtsp://admin:password123@192.168.1.50:554/Streaming/Channels/101
RTSP_URL=rtsp://admin:password@192.168.1.100:554/h264Preview_01_main

# 2. Server Port (Default: 4000)
PORT=4000

# 3. FFmpeg Executable Path
# Use "ffmpeg" if it is in system PATH, or specify the absolute path to ffmpeg.exe
# Example: C:/ffmpeg/bin/ffmpeg.exe or /usr/bin/ffmpeg
FFMPEG_PATH=ffmpeg

# 4. Video Codec ("libx264" or "copy")
# - "libx264" (Default): Re-encodes video for guaranteed browser compatibility.
# - "copy": Stream-copy (no re-encoding). Reduces CPU usage to near 0% if camera already outputs browser-compatible H.264.
VIDEO_CODEC=libx264

# 5. HLS Streaming Low-Latency Settings
# Duration of each HLS segment in seconds (Recommended: 1 to 2)
HLS_SEGMENT_SECONDS=2

# Number of segments maintained in the live playlist index (Recommended: 3 to 5)
HLS_LIST_SIZE=5

# 6. Public Domain / HTTPS URL
# When deployed on Hostinger VPS or a cloud server, set your public domain here.
# Example: https://camera.yourdomain.com
PUBLIC_URL=

# 7. Security: Admin API Key (Optional)
# If set, write operations (creating/updating/deleting cameras) will require
# header: "x-api-key: your-secret-key"
ADMIN_API_KEY=
